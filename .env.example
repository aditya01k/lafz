# --- Self-hosting: these two are all you need. Free, no accounts. ---
# Word timing (Whisper) and the spelling pass.
OPENAI_API_KEY=
# Sarvam writes the text in every Indian language (dashboard.sarvam.ai).
SARVAM_API_KEY=
# Optional: which OpenAI model does the spelling pass.
OPENAI_MODEL=gpt-5.5

# --- Hosted mode: setting DATABASE_URL + BETTER_AUTH_SECRET turns on sign-in and credits. ---
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3300
# Sign-in emails (without it, links are printed to the dev server log).
RESEND_API_KEY=
EMAIL_FROM=
# Google sign-in (optional); set NEXT_PUBLIC_GOOGLE_SIGNIN=1 to show the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_SIGNIN=
# Credit packs are sold through Dodo Payments; products are created automatically.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
